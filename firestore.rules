rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isActiveAuthenticated() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('activo', true) != false;
    }

    function isSuperadmin() {
      return isActiveAuthenticated() && getRole() == 'superadmin';
    }

    function isPersonal() {
      return isActiveAuthenticated() && getRole() == 'personal';
    }

    function isAdoptante() {
      return isActiveAuthenticated() && getRole() == 'adoptante';
    }

    function ownsSolicitud(solicitudId) {
      return isActiveAuthenticated() &&
        get(/databases/$(database)/documents/solicitudes/$(solicitudId)).data.adoptanteId == request.auth.uid;
    }

    function isAllowedOwnUserUpdate(userId) {
      return isActiveAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('activo', true) == resource.data.get('activo', true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre',
          'email',
          'telefono',
          'fotoPerfilUrl',
          'direccion',
          'fcmToken'
        ]);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin());

      allow create: if (
        isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        request.resource.data.role == 'adoptante'
      ) || isSuperadmin();

      allow update: if isSuperadmin() || isAllowedOwnUserUpdate(userId);
    }

    match /userPhones/{phone} {
      allow read: if isAuthenticated() && (resource.data.uid == request.auth.uid || isSuperadmin());

      allow create: if isAuthenticated() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.telefono == phone;

      allow delete: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isSuperadmin());
    }

    match /animales/{animalId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isPersonal();
    }

    match /solicitudes/{solicitudId} {
      allow read: if isAuthenticated() &&
        (resource.data.adoptanteId == request.auth.uid || isPersonal());
      allow create: if isAdoptante();
      allow update: if isPersonal();
    }

    match /entrevistas/{entrevistaId} {
      allow read: if isPersonal() || ownsSolicitud(resource.data.solicitudId);
      allow write: if isPersonal();
    }

    match /reportes/{reporteId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.reportadoPor == request.auth.uid;
      allow delete: if false;
    }

    match /generaciones/{docId} {
      allow read: if isAuthenticated() &&
        (docId.matches(request.auth.uid + '_.*') || resource.data.uid == request.auth.uid);
      allow write: if false;
    }
  }
}
