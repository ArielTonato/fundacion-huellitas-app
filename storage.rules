rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function getRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isPersonal() {
      return isAuthenticated() && getRole() == 'personal';
    }

    function isSuperadmin() {
      return isAuthenticated() && getRole() == 'superadmin';
    }

    match /animales/{animalId}/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isPersonal();
    }

    match /solicitudes/{solicitudId}/{imageId} {
      allow read: if isPersonal() ||
        (isAuthenticated() && resource.metadata.uploadedBy == request.auth.uid);
      allow write: if isAuthenticated() &&
        request.resource.metadata.uploadedBy == request.auth.uid;
    }

    match /reportes/{reporteId}/{imageId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /perfil/{userId}/{imageId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperadmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
  }
}
